PORT=3000
NODE_ENV=development
# Canonical base URL for generated short links (e.g., https://sho.rt or your custom domain)
# If omitted, defaults dynamically to protocol://host from request headers
BASE_URL=http://localhost:3000
# MongoDB connection string (supports either MONGODB_URI or MONGODBURI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/urlShortener
MONGODB_MAX_POOL_SIZE=50
# Comma-separated list of allowed origins or *
ALLOWED_ORIGINS=http://localhost:5173